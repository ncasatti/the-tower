# Do not modify this file!  It was generated by ‘nixos-generate-config’
# and may be overwritten by future invocations.  Please make changes
# to /etc/nixos/configuration.nix instead.
#
# Regenerated 2026-11-16 for the replacement notebook: Intel i7-1165G7
# (Tiger Lake), 238.5 GiB NVMe. Layout: p1 ESP, p2 swap (randomEncryption),
# p3 LUKS2 root. Previous notebook (AMD, unencrypted ext4) is in git history.
# Hand edits on top of the generated file mirror main: SSD root options,
# LUKS allowDiscards/bypassWorkqueues, swap by PARTUUID with randomEncryption.
{ config, lib, pkgs, modulesPath, ... }:

{
  imports =
    [ (modulesPath + "/installer/scan/not-detected.nix")
    ];

  boot.initrd.availableKernelModules = [ "vmd" "xhci_pci" "nvme" "usb_storage" "sd_mod" ];
  boot.initrd.kernelModules = [ ];
  boot.kernelModules = [ "kvm-intel" ];
  boot.extraModulePackages = [ ];

  fileSystems."/" =
    { device = "/dev/mapper/luks-c11be21e-f45c-42c3-b463-8bd74b719aad";
      fsType = "ext4";
      # noatime/nodiratime: fewer metadata writes on SSD. No 'discard':
      # batched TRIM via fstrim.timer (services.fstrim.enable in default.nix).
      # Edit this list HERE. Never override it with lib.mkForce from another
      # module -- see nix/modules/boot-invariants.nix.
      options = [ "noatime" "nodiratime" ];
    };

  boot.initrd.luks.devices."luks-c11be21e-f45c-42c3-b463-8bd74b719aad" = {
    device = "/dev/disk/by-uuid/c11be21e-f45c-42c3-b463-8bd74b719aad";
    # allowDiscards: pass TRIM through the LUKS layer.
    allowDiscards = true;
    # bypassWorkqueues: skip kcryptd workqueues to reduce I/O latency on SSD.
    bypassWorkqueues = true;
  };

  fileSystems."/boot" =
    { device = "/dev/disk/by-uuid/B266-2423";
      fsType = "vfat";
      options = [ "fmask=0077" "dmask=0077" ];
    };

  swapDevices = lib.mkForce [
    {
      # nvme0n1p2, 16 GiB. Left unformatted at install time on purpose.
      device = "/dev/disk/by-partuuid/a58168bc-2f38-4a0c-94f4-df1dce1cd991";
      # randomEncryption: opened in stage 2 with `cryptsetup plainOpen
      # -d /dev/urandom` + mkswap on every boot. No header, no passphrase,
      # no initrd dependency. See docs/swap-architecture.md.
      randomEncryption = {
        enable        = true;
        allowDiscards = true;
      };
    }
  ];

  nixpkgs.hostPlatform = lib.mkDefault "x86_64-linux";
  hardware.cpu.intel.updateMicrocode = lib.mkDefault config.hardware.enableRedistributableFirmware;
}
