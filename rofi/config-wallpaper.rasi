/* ---- 💫 https://github.com/JaKooLit 💫 ---- */
/* Main Config (wallpaper) */

@import "~/.config/rofi/config.rasi"  

/* ---- Configuration ---- */ 
configuration {
  modi: "drun";
}

window {
  /* Base theme forces a height; 65% fits 2 rows of 20% tiles on 1080 and 768. */
  width: 85%;
  height: 65%;
}

/* ---- Mainbox ---- */
mainbox {
  children: [ "inputbar", "listview" ];
  spacing: 15px;
  padding: 15px 20px;
}

/* ---- Inputbar ---- */
inputbar {
  background-color: transparent;
  border: 0;
}

entry {
  expand: true;
  placeholder: "Choose Wallpaper";
  horizontal-align: 0.5;
}

/* ---- Listview ---- */
listview {
  columns: 5;
  lines: 2;
  spacing: 10px;
  padding: 0px;
  flow: horizontal;
  fixed-width: false;
  fixed-height: false;
  cycle: true;
}

/* ---- Element ---- */
element {
  orientation: vertical;
  padding: 6px;
  spacing: 4px;
  border-radius: 2px;
  margin: 0px;
}

element selected.normal {
  background-color: #00000060;
  border: 1px solid;
  border-color: @accent-dim;
}

/* element-icon { text-color:                  inherit; size:                        10%; margin:                      -30px; cursor:                      inherit; } */

element-icon {
  /* Percent of screen HEIGHT (measured: 14% = 151px on 1080, 107px on 768),
     so tiles scale per panel. Fixed 20em overflowed columns on 1366x768. */
  size: 20%;
  border: 0px;
  padding: 0px;
  border-radius: 2px;
  background-color: transparent;
}


/* Theme pads selected text by 16px, which grows the selected tile. */
element-text selected {
  padding: 5px;
}

element-text {
  vertical-align: 0.5;
  horizontal-align: 0.5;
  padding: 5px;
  margin: 0px;
  background-color: transparent;
  expand: false;
}
